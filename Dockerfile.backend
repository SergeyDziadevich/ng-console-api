# ==============================================================================
# Stage 1: Build Stage
# ==============================================================================
FROM node:24-alpine AS builder

WORKDIR /app

# Accept service name as build argument (e.g. api-gateway, user-service, ticket-service, auth-service, etc.)
ARG SERVICE_NAME=api-gateway

# Install dependencies including devDependencies for compilation
COPY package*.json ./
RUN npm ci

# Copy full monorepo source code
COPY . .

# Build target microservice or gateway with production configuration
RUN NODE_OPTIONS="--max-old-space-size=4096" npx nx build ${SERVICE_NAME}

# ==============================================================================
# Stage 2: Lean Production Runtime Stage
# ==============================================================================
FROM node:24-alpine AS runtime

# Install dumb-init for proper signal handling (PID 1)
RUN apk add --no-cache dumb-init

WORKDIR /app

# Accept service name
ARG SERVICE_NAME=api-gateway

# Set production environment
ENV NODE_ENV=production
ENV PORT=3000

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy compiled service output from builder stage
COPY --from=builder /app/dist/apps/${SERVICE_NAME} ./dist

# Set file permissions for non-root user
RUN chown -R node:node /app

# Switch to non-root user
USER node

# Expose default service port
EXPOSE 3000

# Liveness probe check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O - http://localhost:3000/health || exit 1

# Process initiation via dumb-init
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
