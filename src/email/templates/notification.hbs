<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>New Notification</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
        <h2 style="color: #2196F3;">Hello, {{name}}!</h2>
        <p>You have a new notification:</p>
        <div style="background-color: #f5f5f5; padding: 15px; border-left: 4px solid #2196F3; margin: 20px 0;">
            <strong>{{message}}</strong>
        </div>
        {{#if link}}
        <p>
            <a href="{{link}}" style="display: inline-block; padding: 10px 20px; background-color: #2196F3; color: #ffffff; text-decoration: none; border-radius: 5px;">View Ticket</a>
        </p>
        {{/if}}
        <p>Log in to your account to view more details.</p>
        <br>
        <p>Best Regards,</p>
        <p><strong>The Team</strong></p>
    </div>
</body>
</html>
